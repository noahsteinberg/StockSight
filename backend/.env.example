STOCKSIGHT_APP_NAME=stocksight-api
# Empty URL explicitly selects the fixture adapter.
STOCKSIGHT_DATABASE_URL=
# For local PostgreSQL, use your actual Compose password (URL-encoded if needed):
# STOCKSIGHT_DATABASE_URL=postgresql+psycopg://stocksight:PASSWORD@127.0.0.1:5433/stocksight
# Supabase: copy the actual Connect URL; never commit a real password.
# Vercel runtime: Transaction pooler, port 6543. TLS/pooling handled by db.py.
# Migrations/imports: Direct connection or Session pooler, port 5432.
# Optional separate URL used only by Alembic (falls back to DATABASE_URL).
STOCKSIGHT_MIGRATION_DATABASE_URL=
# Full setup and dataset choices: docs/SUPABASE.md
# Auth0 custom API settings; match frontend/.env.local. No client secret needed.
STOCKSIGHT_AUTH0_DOMAIN=
STOCKSIGHT_AUTH0_AUDIENCE=
# Exact browser origin for first-party session creation and CSRF checks.
STOCKSIGHT_APP_ORIGIN=http://127.0.0.1:5173
# Absolute app-session lifetime; no sliding extension on refresh (8 hours).
STOCKSIGHT_SESSION_MAX_AGE_SECONDS=28800
